# Selecting environment
# DOMAIN_MODE=""
# NEXT_PUBLIC_DOMAIN_MODE=""

# Database
# DATABASE_URL=""
# DIRECT_URL=""

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Google OAuth
# NEXT_PUBLIC_GOOGLE_OAUTH_ID=""
# Client secret for the same OAuth client above — needed for the auth-code exchange
# that connects a user's Google Calendar (Meeting push sync). Get it from the
# Credentials page for that client in Google Cloud Console; also enable the
# Google Calendar API and add the calendar.events scope on the consent screen.
# GOOGLE_CLIENT_SECRET=""

# Google Ads Conversion Tag
# NEXT_PUBLIC_GOOGLE_ADS_ID=""
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_SEND_TO=""

# Meta Pixel
# NEXT_PUBLIC_META_PIXEL_ID=""

# Mailtrap
# MAILTRAP_API_TOKEN=""
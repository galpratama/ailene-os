generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Mirrors docs/db/ailene-os-ddl.sql.

////////////////////
// Enumerations   //
////////////////////

enum StatusEnum {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("status_enum")
}

// Enumeration for the User model

// What a user may do. Deliberately coarse: two roles, no join table, no permission bitmask.
enum UserRoleEnum {
  ADMINISTRATOR @map("administrator")
  MEMBER        @map("member")

  @@map("user_role_enum")
}

// Account lifecycle for internal OS users — distinct from the shared StatusEnum.
enum UserAccountStatusEnum {
  INVITED     @map("invited")
  ACTIVE      @map("active")
  SUSPENDED   @map("suspended")
  DEACTIVATED @map("deactivated")
  ARCHIVED    @map("archived")

  @@map("user_account_status_enum")
}

// Job function is independent of role: it describes where someone sits in the org, never what they may do.
enum JobFunctionEnum {
  BD         @map("bd")
  SALES      @map("sales")
  OPERATIONS @map("operations")
  CURRICULUM @map("curriculum")
  FINANCE    @map("finance")
  IT         @map("it")

  @@map("job_function_enum")
}

enum DataScopeEnum {
  OWN    @map("own")
  TEAM   @map("team")
  GLOBAL @map("global")

  @@map("data_scope_enum")
}

// Entity types a Notification can point at.
enum NotificationEntityTypeEnum {
  B2B_PIPELINE @map("b2b_pipeline")
  B2B_ACTION   @map("b2b_action")
  B2B_MEETING  @map("b2b_meeting")

  @@map("notification_entity_type_enum")
}

enum NotificationTypeEnum {
  NEW_ASSIGNMENT       @map("new_assignment")
  MEETING_TIME_CHANGED @map("meeting_time_changed")
  OVERDUE_NEXT_ACTION  @map("overdue_next_action")

  @@map("notification_type_enum")
}

// Push-only sync state of a B2BMeeting into the organizer's connected Google Calendar.
enum GoogleCalendarSyncStatusEnum {
  NOT_SYNCED  @map("not_synced")
  SYNCED      @map("synced")
  SYNC_FAILED @map("sync_failed")

  @@map("google_calendar_sync_status_enum")
}

enum LeadSourceEnum {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")

  @@map("lead_source_enum")
}

enum LeadChannelEnum {
  REFERRAL  @map("referral")
  LINKEDIN  @map("linkedin")
  THREAD    @map("thread")
  INSTAGRAM @map("instagram")

  @@map("lead_channel_enum")
}

// Enumeration for the B2BMeeting model (b2bm_*)

enum B2BMeetingStatusEnum {
  SCHEDULED @map("scheduled")
  HELD      @map("held")
  CANCELLED @map("cancelled")
  NO_SHOW   @map("no_show")

  @@map("b2bm_status_enum")
}

// Enumeration for the TrainerPool models (trainer_*, trnsc_*, trncert_*, trna_*)

enum TrainerLevelEnum {
  JUNIOR @map("junior")
  SENIOR @map("senior")

  @@map("trainer_level_enum")
}

// Pipeline stage — derived automatically from screening/certification
// progress, never set directly by an admin.
enum TrainerStageEnum {
  CANDIDATE     @map("candidate")
  QUALIFIED     @map("qualified")
  NOT_QUALIFIED @map("not_qualified")
  ELIGIBLE      @map("eligible")
  NOT_ELIGIBLE  @map("not_eligible")

  @@map("trainer_stage_enum")
}

// Simple on/off flag, independent of pipeline stage — for backend filtering
// (e.g. hiding a trainer without touching their pipeline progress).
enum TrainerStatusEnum {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("trainer_status_enum")
}

enum TrainerSourceEnum {
  AI_COMMUNITY           @map("ai_community")
  TOP_ALUMNI             @map("top_alumni")
  DOMAIN_PRACTITIONER    @map("domain_practitioner")
  TRAINER_NETWORK        @map("trainer_network")
  CORPORATE_PRACTITIONER @map("corporate_practitioner")
  INTERNAL_REFERRAL      @map("internal_referral")

  @@map("trainer_source_enum")
}

enum TrainerScreeningStatusEnum {
  PENDING @map("pending")
  PASSED  @map("passed")
  FAILED  @map("failed")
  SKIPPED @map("skipped")

  @@map("trnsc_status_enum")
}

enum TrainerCertificationStatusEnum {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  PASSED      @map("passed")
  FAILED      @map("failed")

  @@map("trncert_status_enum")
}

// Enumeration for the LMS tables (lms_*) — migrated from the Sevenpreneur
// AI-LMS database's ail_* schema (docs/db/ailene-ddl.sql in that repo).

enum LmsChapterMethodEnum {
  ONLINE  @map("online")
  OFFLINE @map("offline")

  @@map("lms_chapter_method_enum")
}

////////////
// Models //
////////////

// Lookup tables

model TrainerSpecialization {
  id                  Int                        @id @default(autoincrement()) @db.SmallInt
  specialization_name String                     @unique @db.VarChar()
  created_at          DateTime                   @default(now()) @db.Timestamptz()
  trainers            TrainerSpecializationMap[]

  @@map("trainer_specializations")
}

// User data

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  full_name                  String                    @db.VarChar()
  email                      String                    @unique @db.VarChar()
  avatar                     String?                   @db.VarChar()
  role                       UserRoleEnum              @default(MEMBER)
  team_id                    Int?                      @db.SmallInt
  job_function               JobFunctionEnum?
  data_scope                 DataScopeEnum             @default(OWN)
  status                     UserAccountStatusEnum     @default(ACTIVE)
  invited_by                 User?                     @relation("UserInvitedBy", fields: [invited_by_id], references: [id])
  invited_by_id              String?                   @db.Uuid
  invited_at                 DateTime?                 @db.Timestamptz()
  invited_users              User[]                    @relation("UserInvitedBy")
  created_at                 DateTime                  @default(now()) @db.Timestamptz()
  updated_at                 DateTime                  @default(now()) @updatedAt @db.Timestamptz()
  last_login                 DateTime                  @default(now()) @updatedAt @db.Timestamptz()
  deleted_at                 DateTime?                 @db.Timestamptz()
  tokens                     Token[]
  sales_pipelines            Pipeline[]                @relation("PipelineSalesOwner")
  trainer_profile            Trainer?                  @relation("TrainerUser")
  trainer_referrals          Trainer[]                 @relation("TrainerReferrer")
  trainer_scores             TrainerScreening[]        @relation("TrainerScreeningScorer")
  meetings_organized         B2BMeeting[]              @relation("B2BMeetingOrganizer")
  meetings_created           B2BMeeting[]              @relation("B2BMeetingCreatedBy")
  notifications              Notification[]
  google_calendar_connection GoogleCalendarConnection?

  @@map("users")
}

model Token {
  id         Int      @id @default(autoincrement()) @db.Integer
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String   @db.Uuid
  is_active  Boolean  @default(false) @db.Boolean
  token      String   @unique @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()

  @@map("tokens")
}

// One row per connected Google account; refresh_token drives the one-way (Ailene OS ->
// Google Calendar) push sync for B2BMeeting. No read-back from Google in this slice.
model GoogleCalendarConnection {
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id            String    @id @db.Uuid
  refresh_token      String    @db.Text
  access_token       String?   @db.Text
  token_expiry       DateTime? @db.Timestamptz()
  google_calendar_id String    @default("primary") @db.VarChar()
  connected_at       DateTime  @default(now()) @db.Timestamptz()
  revoked_at         DateTime? @db.Timestamptz()

  @@map("google_calendar_connections")
}

// In-app notification feed — new assignment, meeting time changed, overdue next action.
model Notification {
  id          Int                        @id @default(autoincrement())
  user        User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     String                     @db.Uuid
  type        NotificationTypeEnum
  entity_type NotificationEntityTypeEnum
  entity_id   Int
  message     String                     @db.Text
  read_at     DateTime?                  @db.Timestamptz()
  created_at  DateTime                   @default(now()) @db.Timestamptz()

  @@index([user_id])
  @@map("notifications")
}

// Sales API organization. One company has exactly one active Pipeline row.
model Company {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar()
  normalized_name  String           @unique @db.VarChar()
  legal_identifier String?          @db.VarChar()
  industry_id      Int?             @db.SmallInt
  lead_source      LeadSourceEnum?
  lead_channel     LeadChannelEnum?
  website_url      String?          @db.VarChar()
  image_url        String?          @db.VarChar()
  created_at       DateTime         @default(now()) @db.Timestamptz()
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz()
  pipeline         Pipeline?
  lms_projects     LmsProject[]

  @@index([lead_channel])
  @@map("companies")
}

// Sales API pipeline. Its company name is the user-facing label because there is one pipeline per company.
model Pipeline {
  id                  Int          @id @default(autoincrement())
  company             Company      @relation(fields: [company_id], references: [id])
  company_id          Int          @unique
  sales_owner         User         @relation("PipelineSalesOwner", fields: [sales_owner_id], references: [id])
  sales_owner_id      String       @db.Uuid
  stage_code          String       @db.VarChar(40)
  estimated_value     Decimal      @default(0) @db.Decimal(15, 2)
  expected_close_date DateTime?    @db.Date
  qualified_at        DateTime?    @db.Timestamptz()
  meeting_booked_at   DateTime?    @db.Timestamptz()
  closed_at           DateTime?    @db.Timestamptz()
  created_at          DateTime     @default(now()) @db.Timestamptz()
  updated_at          DateTime     @default(now()) @updatedAt @db.Timestamptz()
  meetings            B2BMeeting[]
  lms_projects        LmsProject[]

  @@index([sales_owner_id])
  @@index([stage_code])
  @@map("pipelines")
}

// A held/scheduled meeting on a pipeline; organizer_id records who actually ran the meeting.
model B2BMeeting {
  id                 Int                          @id @default(autoincrement())
  pipeline           Pipeline                     @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  pipeline_id        Int
  organizer          User                         @relation("B2BMeetingOrganizer", fields: [organizer_id], references: [id])
  organizer_id       String                       @db.Uuid
  scheduled_at       DateTime                     @db.Timestamptz()
  held_at            DateTime?                    @db.Timestamptz()
  status             B2BMeetingStatusEnum         @default(SCHEDULED)
  location_or_link   String?                      @db.VarChar()
  notes              String?                      @db.Text
  // Push-only (Ailene OS -> Google Calendar) sync state on the organizer's connected calendar.
  google_event_id    String?                      @db.VarChar()
  google_sync_status GoogleCalendarSyncStatusEnum @default(NOT_SYNCED)
  google_sync_error  String?                      @db.Text
  last_synced_at     DateTime?                    @db.Timestamptz()
  created_by         User                         @relation("B2BMeetingCreatedBy", fields: [created_by_id], references: [id])
  created_by_id      String                       @db.Uuid
  created_at         DateTime                     @default(now()) @db.Timestamptz()
  updated_at         DateTime                     @default(now()) @updatedAt @db.Timestamptz()

  @@index([pipeline_id])
  @@index([scheduled_at])
  @@map("meetings")
}

// Trainer Pool

model Trainer {
  id                  String                     @id @default(nanoid()) @db.Char(21)
  source              TrainerSourceEnum?
  level               TrainerLevelEnum           @default(JUNIOR)
  stage               TrainerStageEnum           @default(CANDIDATE)
  status              TrainerStatusEnum          @default(ACTIVE)
  user                User                       @relation("TrainerUser", fields: [user_id], references: [id])
  user_id             String                     @unique @db.Uuid
  phone               String?                    @db.VarChar()
  referrer            User?                      @relation("TrainerReferrer", fields: [referred_by], references: [id])
  referred_by         String?                    @db.Uuid
  notes               String?                    @db.Text
  ai_experience_years Int                        @default(0) @db.SmallInt
  created_at          DateTime                   @default(now()) @db.Timestamptz()
  updated_at          DateTime                   @default(now()) @updatedAt @db.Timestamptz()
  deleted_at          DateTime?                  @db.Timestamptz()
  specializations     TrainerSpecializationMap[]
  screening           TrainerScreening?
  certification       TrainerCertification?
  chapters            LmsChapter[]

  @@map("trainers")
}

model TrainerSpecializationMap {
  trainer           Trainer               @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  trainer_id        String                @db.Char(21)
  specialization    TrainerSpecialization @relation(fields: [specialization_id], references: [id], onDelete: Cascade)
  specialization_id Int                   @db.SmallInt

  @@id([trainer_id, specialization_id])
  @@map("trainer_specialization_map")
}

model TrainerScreening {
  id                       Int                        @id @default(autoincrement())
  trainer                  Trainer                    @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  trainer_id               String                     @unique @db.Char(21)
  application_review       TrainerScreeningStatusEnum @default(PENDING)
  interview                TrainerScreeningStatusEnum @default(PENDING)
  teaching_demo            TrainerScreeningStatusEnum @default(PENDING)
  practical_test           TrainerScreeningStatusEnum @default(PENDING)
  reference_check          TrainerScreeningStatusEnum @default(PENDING)
  ai_hands_on_score        Int                        @default(0) @db.SmallInt
  facilitation_score       Int                        @default(0) @db.SmallInt
  domain_credibility_score Int                        @default(0) @db.SmallInt
  communication_score      Int                        @default(0) @db.SmallInt
  reliability_score        Int                        @default(0) @db.SmallInt
  total_score              Int                        @default(0) @db.SmallInt
  scorer                   User?                      @relation("TrainerScreeningScorer", fields: [scored_by], references: [id])
  scored_by                String?                    @db.Uuid
  scored_at                DateTime?                  @db.Timestamptz()
  created_at               DateTime                   @default(now()) @db.Timestamptz()
  updated_at               DateTime                   @default(now()) @updatedAt @db.Timestamptz()

  @@map("trainer_screenings")
}

model TrainerCertification {
  id                     Int                            @id @default(autoincrement())
  trainer                Trainer                        @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  trainer_id             String                         @unique @db.Char(21)
  orientation            TrainerCertificationStatusEnum @default(NOT_STARTED)
  material_mastery       TrainerCertificationStatusEnum @default(NOT_STARTED)
  shadowing              TrainerCertificationStatusEnum @default(NOT_STARTED)
  co_training            TrainerCertificationStatusEnum @default(NOT_STARTED)
  solo_observed_delivery TrainerCertificationStatusEnum @default(NOT_STARTED)
  certification_decision TrainerCertificationStatusEnum @default(NOT_STARTED)
  created_at             DateTime                       @default(now()) @db.Timestamptz()
  updated_at             DateTime                       @default(now()) @updatedAt @db.Timestamptz()

  @@map("trainer_certifications")
}

// LMS models the Class Marketplace reads; the LMS itself is served by ailene-lms-api.

model LmsProject {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar()
  company      Company?   @relation(fields: [company_id], references: [id], onDelete: SetNull)
  company_id   Int?
  pipeline     Pipeline   @relation(fields: [pipeline_id], references: [id], onDelete: Restrict)
  pipeline_id  Int
  attendee_pax Int?
  created_at   DateTime   @default(now()) @db.Timestamptz()
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz()
  levels       LmsLevel[]

  @@map("lms_projects")
}

model LmsLevel {
  id           Int          @id @default(autoincrement())
  level_number Int          @unique @db.SmallInt
  name         String       @db.VarChar()
  icon         String?      @db.VarChar()
  min_xp       Int          @default(0)
  status       StatusEnum   @default(ACTIVE)
  project      LmsProject   @relation(fields: [project_id], references: [id])
  project_id   Int
  created_at   DateTime     @default(now()) @db.Timestamptz()
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz()
  chapters     LmsChapter[]

  @@map("lms_levels")
}

model LmsChapter {
  id               Int                  @id @default(autoincrement())
  level            LmsLevel             @relation(fields: [level_id], references: [id])
  level_id         Int
  name             String               @db.VarChar()
  description      String?              @db.Text
  session_date     DateTime             @db.Timestamptz()
  status           StatusEnum           @default(ACTIVE)
  trainer          Trainer?             @relation(fields: [trainer_id], references: [id], onDelete: SetNull)
  trainer_id       String?              @db.Char(21)
  method           LmsChapterMethodEnum @default(OFFLINE)
  location_url     String               @db.VarChar()
  location_name    String               @db.VarChar()
  duration_minutes Int
  created_at       DateTime             @default(now()) @db.Timestamptz()
  updated_at       DateTime             @default(now()) @updatedAt @db.Timestamptz()

  @@map("lms_chapters")
}
